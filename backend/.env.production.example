# ====================================================================
# Aprovando Tech - Backend Production Environment (.env.production)
# ====================================================================

NODE_ENV=production
PORT=3000

# CORS restrito para domínios oficiais de produção (separados por vírgula)
CORS_ORIGIN=https://aprovandotech.com.br,https://app.aprovandotech.com.br

# Supabase (Produção)
SUPABASE_URL=https://your-prod-project.supabase.co
SUPABASE_ANON_KEY=your_prod_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_prod_service_role_key

# Redis Gerenciado / Produção (ex: Redis Cloud, Upstash, ElastiCache, Docker com senha)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_strong_redis_password
REDIS_TLS=false

# LLM Providers (Chaves de Produção)
OPENAI_API_KEY=your_production_openai_key
GOOGLE_AI_API_KEY=your_production_google_key
GROQ_API_KEY=your_production_groq_key

# JWT Secret forte de Produção
JWT_SECRET=generate-a-strong-random-secret-for-production-min-64-chars
