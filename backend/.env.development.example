# ====================================================================
# Aprovando Tech - Backend Development Environment (.env.development)
# ====================================================================

NODE_ENV=development
PORT=3000

# Permite acesso do Angular local ou qualquer rota em dev
CORS_ORIGIN=*

# Supabase (Dev / Staging)
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=your_dev_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_dev_service_role_key

# Redis Local (Docker ou standalone)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# LLM Providers
OPENAI_API_KEY=your_dev_openai_key
GOOGLE_AI_API_KEY=your_dev_google_key
GROQ_API_KEY=your_dev_groq_key

# JWT Secret
JWT_SECRET=dev-secret-aprovando-tech-key
